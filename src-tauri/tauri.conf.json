{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-hil-debugger",
  "version": "1.3.8",
  "identifier": "com.aihil.debugger",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI-HIL 嵌入式硬件在环测试与调试系统",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 http://127.0.0.1:5173 ws://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "externalBin": [
      "binaries/hil-daemon"
    ],
    "resources": {
      "binaries/hil-python-worker.exe": "hil-python-worker.exe",
      "binaries/hil-protocol.exe": "hil-protocol.exe",
      "binaries/mcp-tools.json": "mcp-tools.json",
      "../packs/INGChips.INGCHIPS_DeviceFamilyPack.1.0.1.pack": "packs/INGChips.INGCHIPS_DeviceFamilyPack.1.0.1.pack",
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERTczMTg2QkZERDhGQjIKUldTeWo5Mi9oakhuVFM1RmRBQnNwVVg5b2poejNJM0NlMHZMNzVwc1dDeFlBaEk3QlV4Wk12R2IK",
      "endpoints": [
        "https://github.com/ZenghuiJIA/ingchips_debug_tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
