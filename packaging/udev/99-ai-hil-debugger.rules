# udev rules for AI-HIL Debugger (DAPLink / CMSIS-DAP, J-Link, and common USB-Serial adapters)
# Install to /usr/lib/udev/rules.d/99-ai-hil-debugger.rules (or /etc/udev/rules.d/)
# Reload with: sudo udevadm control --reload-rules && sudo udevadm trigger

# ARM CMSIS-DAP / DAPLink (HID & WinUSB/Bulk)
SUBSYSTEM=="usb", ATTR{idVendor}=="0d28", ATTR{idProduct}=="0204", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0d28", ATTRS{idProduct}=="0204", MODE="0666", GROUP="uucp", TAG+="uaccess"
ATTRS{product}=="*CMSIS-DAP*", MODE="0666", GROUP="uucp", TAG+="uaccess"
ATTRS{product}=="*DAPLink*", MODE="0666", GROUP="uucp", TAG+="uaccess"

# SEGGER J-Link (all PIDs)
SUBSYSTEM=="usb", ATTR{idVendor}=="1366", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1366", MODE="0666", GROUP="uucp", TAG+="uaccess"

# STMicroelectronics ST-Link V2 / V2-1 / V3
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3748", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374b", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374e", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="374f", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3753", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="3754", MODE="0666", GROUP="uucp", TAG+="uaccess"

# Common USB-to-Serial Adapters (CH340/CH341/CH343, CP210x, FTDI, PL2303)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", MODE="0666", GROUP="uucp", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", MODE="0666", GROUP="uucp", TAG+="uaccess"
