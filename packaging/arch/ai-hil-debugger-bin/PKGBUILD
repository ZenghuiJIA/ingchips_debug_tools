# Maintainer: ZenghuiJIA <zenghui.JIA@ingchips.com>
pkgname=ai-hil-debugger-bin
_pkgname=ai-hil-debugger
pkgver=1.3.8
pkgrel=1
pkgdesc="AI-Driven Embedded Hardware-in-the-Loop (HIL) Testing & Debugging Desktop Tool (prebuilt)"
arch=('x86_64')
url="https://github.com/ZenghuiJIA/ingchips_debug_tools"
license=('Apache-2.0')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libusb'
  'hidapi'
)
options=('!strip')
install=ai-hil-debugger.install
source=("AI-HIL-Debugger-v${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/AI-HIL-Debugger-v${pkgver}-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/AI-HIL-Debugger-v${pkgver}-linux-x86_64"

  install -Dm755 "bin/ai-hil-debugger" "${pkgdir}/usr/bin/ai-hil-debugger"
  install -Dm755 "bin/hil-daemon" "${pkgdir}/usr/bin/hil-daemon"

  install -Dm755 "lib/hil-python-worker" "${pkgdir}/usr/lib/${_pkgname}/hil-python-worker"
  install -Dm755 "lib/hil-protocol" "${pkgdir}/usr/lib/${_pkgname}/hil-protocol"
  install -Dm644 "lib/mcp-tools.json" "${pkgdir}/usr/lib/${_pkgname}/mcp-tools.json"
  install -Dm644 "lib/packs/INGChips.INGCHIPS_DeviceFamilyPack.1.0.1.pack" \
    "${pkgdir}/usr/lib/${_pkgname}/packs/INGChips.INGCHIPS_DeviceFamilyPack.1.0.1.pack"

  install -Dm644 "share/ai-hil-debugger.desktop" \
    "${pkgdir}/usr/share/applications/${_pkgname}.desktop"
  install -Dm644 "share/ai-hil-debugger.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/${_pkgname}.png"
  install -Dm644 "udev/99-ai-hil-debugger.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-ai-hil-debugger.rules"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
