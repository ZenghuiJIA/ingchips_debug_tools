# Maintainer: ZenghuiJIA <zenghui.JIA@ingchips.com>
pkgname=ai-hil-debugger
pkgver=1.3.7
pkgrel=1
pkgdesc="AI-Driven Embedded Hardware-in-the-Loop (HIL) Testing & Debugging Desktop Tool"
arch=('x86_64')
url="https://github.com/ZenghuiJIA/ingchips_debug_tools"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libusb'
  'hidapi'
)
makedepends=(
  'git'
  'nodejs'
  'pnpm'
  'rust'
  'cargo'
  'python'
  'python-pip'
)
options=('!strip' '!lto')
install=ai-hil-debugger.install
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}/ingchips_debug_tools-${pkgver}"
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "${srcdir}/ingchips_debug_tools-${pkgver}"

  python -m venv --system-site-packages "${srcdir}/venv"
  "${srcdir}/venv/bin/pip" install --no-deps -q pyinstaller 2>/dev/null || \
    "${srcdir}/venv/bin/pip" install -q -r requirements-daemon.txt

  "${srcdir}/venv/bin/python" scripts/build_daemon_linux.py
  pnpm build
  cargo build --locked --release --manifest-path src-tauri/Cargo.toml --no-default-features
}

package() {
  cd "${srcdir}/ingchips_debug_tools-${pkgver}"

  install -Dm755 "src-tauri/target/release/ai-hil-debugger" "${pkgdir}/usr/bin/ai-hil-debugger"
  install -Dm755 "src-tauri/binaries/hil-daemon-x86_64-unknown-linux-gnu" "${pkgdir}/usr/bin/hil-daemon"

  install -Dm755 "src-tauri/binaries/hil-python-worker" "${pkgdir}/usr/lib/${pkgname}/hil-python-worker"
  install -Dm755 "src-tauri/binaries/hil-protocol" "${pkgdir}/usr/lib/${pkgname}/hil-protocol"
  install -Dm644 "src-tauri/binaries/mcp-tools.json" "${pkgdir}/usr/lib/${pkgname}/mcp-tools.json"
  install -Dm644 "packs/INGChips.INGCHIPS_DeviceFamilyPack.1.0.1.pack" \
    "${pkgdir}/usr/lib/${pkgname}/packs/INGChips.INGCHIPS_DeviceFamilyPack.1.0.1.pack"

  install -Dm644 "packaging/linux/ai-hil-debugger.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 "src-tauri/icons/128x128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/${pkgname}.png"
  install -Dm644 "packaging/udev/99-ai-hil-debugger.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-ai-hil-debugger.rules"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
