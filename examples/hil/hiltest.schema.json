{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-HIL test schema v2",
  "description": "Editor completion schema. validate_hiltest additionally validates paths, backend capabilities, numeric bounds and resources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "bench": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probe_id": {},
            "target_device": {},
            "port_name": {},
            "baud_rate": {},
            "frequency": {},
            "pack_path": {}
          }
        }
      ]
    },
    "parameters": {
      "type": "object"
    },
    "loop_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "stop_on_error": {
      "type": "boolean"
    },
    "timeout_ms": {
      "$ref": "#/$defs/duration"
    },
    "steps": {
      "$ref": "#/$defs/steps"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "memory_addr": {
          "type": [
            "integer",
            "string"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "timeout_ms": {
          "$ref": "#/$defs/duration"
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h)|\\$\\{[\\w.-]+\\})$"
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "delay"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay_ms": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "serial_open"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baud_rate": {},
                  "port_name": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "serial_send"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baud_rate": {},
                  "port_name": {},
                  "send_data": {},
                  "send_ending": {},
                  "send_format": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "serial_wait_match"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baud_rate": {},
                  "idle_timeout_ms": {},
                  "match_type": {},
                  "pattern": {},
                  "port_name": {},
                  "timeout_ms": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "hil_observe"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baud_rate": {},
                  "boot_count": {},
                  "boot_timeout_ms": {},
                  "continue_on_failure": {},
                  "idle_timeout_ms": {},
                  "port_name": {},
                  "timeout_ms": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "flash_firmware"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "after_flash": {},
                  "baud_rate": {},
                  "file_path": {},
                  "flash_type": {},
                  "frequency": {},
                  "pack_path": {},
                  "port_name": {},
                  "probe_id": {},
                  "single_addr": {},
                  "target_device": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "reset_target"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "baud_rate": {},
                  "frequency": {},
                  "pack_path": {},
                  "port_name": {},
                  "probe_id": {},
                  "pulse_ms": {},
                  "reset_method": {},
                  "target_device": {},
                  "pin_reset": {
                    "type": "object",
                    "required": [
                      "profile_id",
                      "wiring_verified",
                      "reset_asserted_dtr",
                      "boot_asserted_rts",
                      "settle_ms",
                      "pulse_ms",
                      "boot_hold_ms"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "profile_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "wiring_verified": {
                        "const": true
                      },
                      "reset_asserted_dtr": {
                        "type": "boolean"
                      },
                      "boot_asserted_rts": {
                        "type": "boolean"
                      },
                      "settle_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      "pulse_ms": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5000
                      },
                      "boot_hold_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "swd_read_assert"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_value": {},
                  "frequency": {},
                  "memory_addr": {},
                  "operator": {},
                  "pack_path": {},
                  "probe_id": {},
                  "read_width": {},
                  "target_device": {},
                  "timeout_ms": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "swd_read_block"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "axf_path": {},
                  "count": {},
                  "frequency": {},
                  "memory_addr": {},
                  "pack_path": {},
                  "probe_id": {},
                  "symbol": {},
                  "target_device": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "svd_check_reg"
              },
              "enabled": {
                "type": "boolean",
