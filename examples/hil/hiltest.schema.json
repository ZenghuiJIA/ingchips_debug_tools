                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_reg_val": {},
                  "field_name": {},
                  "frequency": {},
                  "operator": {},
                  "pack_path": {},
                  "peripheral": {},
                  "probe_id": {},
                  "register": {},
                  "target_device": {},
                  "timeout_ms": {}
                }
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,80}$"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "loop_block"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue",
                  "retry"
                ]
              },
              "retry_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "count": {}
                }
              },
              "steps": {
                "$ref": "#/$defs/steps"
              }
            },
            "required": [
              "action"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "params"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "const": "protocol_request"
              },
              "enabled": {
                "type": "boolean"
              },
              "timeout_ms": {
                "$ref": "#/$defs/duration"
              },
              "on_failure": {
                "enum": [
                  "abort",
                  "continue"
                ]
              },
              "retry_count": {
                "const": 0
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "protocol",
                  "values",
                  "expected"
                ],
                "properties": {
                  "port_name": {
                    "type": "string"
                  },
                  "baud_rate": {
                    "type": "integer"
                  },
                  "protocol": {
                    "type": [
                      "object",
                      "string"
                    ]
                  },
                  "values": {
                    "type": "object"
                  },
                  "expected": {
                    "type": "object",
                    "minProperties": 1
                  },
