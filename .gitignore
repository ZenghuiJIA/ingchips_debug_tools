# ========================================================
# AI-HIL Debugger - Comprehensive .gitignore
# Covers: Rust/Cargo, Vue3/Vite/Node, Python/PyOCD, Tauri v2, OS & IDEs
# ========================================================

# --------------------------------------------------------
# 1. Operating System Files
# --------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --------------------------------------------------------
# 2. Node.js, Frontend & Build Artifacts (Vite / Vue 3)
# --------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Web asset compilation output
dist/
dist-ssr/
*.local
.turbo/

# --------------------------------------------------------
# 3. Rust & Tauri v2 Build Artifacts
# --------------------------------------------------------
target/
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk

# --------------------------------------------------------
# 4. Large Executables & Release Distribution Packages
# (Source code is tracked; compiled binaries go to releases)
# --------------------------------------------------------
*.exe
bin/
release/
*.zip
*.tar.gz
*.7z

# --------------------------------------------------------
# 5. Python & PyInstaller Caches
# --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist-py/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# PyInstaller temporary spec / build folders
*.manifest
*.spec

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# --------------------------------------------------------
# 6. Application Logs & WebView2 Runtime Data
# --------------------------------------------------------
*.log
crash.log
app_debug.log
EBWebView/
*.bak
app_debug.log
crash.log

# --------------------------------------------------------
# 7. IDE, Editor & Workspace Configs
# --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
